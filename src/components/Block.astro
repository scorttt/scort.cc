---
import { Icon } from "astro-icon/components";

const { title, headerColor, collapsible = false, defCollapsed = false, links = [], class: className } = Astro.props;
---

<div class="flex flex-col block-wrapper">
    <div class="block-header" data-headerColor={headerColor} data-collapsible={collapsible}>
        <div class="flex items-start justify-between w-full z-10">
            <div class="font-bold text-2xl flex items-center gap-1">
                {collapsible == true && (
                    <button class="collapse-btn" aria-label="Toggle" data-default-collapsed={defCollapsed}>
                        <Icon name="lucide:chevron-down" class="collapse-icon" />
                    </button>
                )}
                <span>{title}</span>
            </div>

            <div class="flex items-center gap-2 link-icons">
                {links.map((item: any) => (
                    <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={item.label}
                        aria-label={item.label}
                    >
                        <Icon
                            name={item.icon}
                            class={headerColor != "blue" ? "text-tertiary" : "text-secondary"}
                        />
                    </a>
                ))}
            </div>
        </div>
    </div>
    <div class={"flex flex-col block-content " + className + (defCollapsed ? " collapsed" : "")}>
        <slot />
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => 
    {
        document.querySelectorAll(".block-header").forEach((header) =>
        {
            const wrapper = header.closest(".block-wrapper");
            const button = wrapper?.querySelector(".collapse-btn");
            
            if (!button)
                return;
        
            const content = wrapper?.querySelector(".block-content");
            const icon = button.querySelector(".collapse-icon") as HTMLElement;

            if (button.getAttribute("data-default-collapsed") === "true" && icon)
                icon.style.transform = "rotate(-90deg)";

            header.addEventListener("click", () => 
            {
                if (!content || !icon)
                    return;
                
                const collapsed = content.classList.toggle("collapsed");
                icon.style.transform = collapsed ? "rotate(-90deg)" : "rotate(0deg)";
            });
        });
    });
</script>

<style> 
    .block-header {
        padding: 1em;
        margin-bottom: 0.25em;
        background-color: color-mix(in srgb, var(--bg-tertiary), transparent 50%);
        backdrop-filter: blur(10px) saturate(1.5); /* flickers on firefox when using ClientRouter, firefox bug so i dont really care working around it */
        box-shadow: var(--box-shadow-white-glow);
        position: relative;
        border-radius: var(--radius-default);
        border: 1px solid var(--border-color);
        border-bottom: none;
    }
    
    .block-header[data-headerColor="blue"] {
        background-color: var(--accent-blue-transparent);
        backdrop-filter: blur(10px) saturate(2.5);
        box-shadow: var(--box-shadow-blue);
        border: 1px solid var(--box-shadow-blue);
        border-bottom: none;
    }
    
    .block-header[data-collapsible="true"],
    .collapse-btn {
        cursor: pointer;
    }
    
    .block-content {
        padding: 1em;
        background-color: color-mix(in srgb, var(--bg-secondary), transparent 50%);
        backdrop-filter: blur(10px) saturate(1.5);
        box-shadow: var(--box-shadow-white-glow);
        border-radius: var(--radius-default);
        border: 1px solid var(--border-color);
        flex: 1;
        transition: all 0.5s cubic-bezier(0.5, 1, 0, 1);
        overflow: visible;
        scrollbar-width: none;
        max-height: 5000px;
    }
    
    .block-content.collapsed {
        max-height: 0;
        opacity: 0;
        padding-bottom: 0;
        padding-top: 0;
        overflow: hidden;
    }
    
    .collapse-btn {
        padding-right: 0.3rem;
        cursor: pointer;
    }

    .collapse-icon {
        transition: all 0.5s cubic-bezier(0.5, 1, 0, 1);
    }
    
    .p-0 {
        padding: 0;
    }

    .link-icons a {
        padding: 0.5rem;
        transition: all 0.5s cubic-bezier(0.5, 1, 0, 1);
        border-radius: 99px;
        cursor: pointer;
    }

    .link-icons a:hover {
        box-shadow: 0rem 0rem 1rem 0.5rem rgba(255, 255, 255, 0.2);
        background-color: rgba(255, 255, 255, 0.15);
    }
</style>