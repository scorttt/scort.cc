---
import { Icon } from 'astro-icon/components';
---
<div class="clock-container">
    <div class="clock-display">
        <div class="clock-time-row">
            <Icon name="lucide:clock" class="clock-icon text" />
            <span class="clock-time text" id="clock-time">00:00:00</span>
        </div>
        <span class="clock-timezone" id="clock-timezone"><span id="clock-timezone-name">PST</span> <span id="clock-timezone-diff"></span></span>
    </div>
</div>

<script>
    const TIME_ZONE = 'America/Los_Angeles';

    // built once instead of every tick
    const timeFormat = new Intl.DateTimeFormat('en-US',
    {
        timeZone: TIME_ZONE,
        hour: '2-digit', // fixed width so the card doesn't shift at 10:00
        minute: '2-digit',
        second: '2-digit',
        hour12: true
    });
    const offsetFormat = new Intl.DateTimeFormat('en-US', { timeZone: TIME_ZONE, timeZoneName: 'shortOffset' });
    const nameFormat = new Intl.DateTimeFormat('en-US', { timeZone: TIME_ZONE, timeZoneName: 'short' });

    let tickTimer: ReturnType<typeof setTimeout> | null = null;

    function myOffsetMinutes(now: Date): number
    {
        const name = offsetFormat.formatToParts(now).find(part => part.type === 'timeZoneName')?.value;
        const match = name?.match(/GMT([+-])(\d+)(?::(\d+))?/);

        if (!match)
            return -8 * 60;

        const sign = match[1] === '-' ? -1 : 1;
        return sign * (parseInt(match[2]) * 60 + parseInt(match[3] ?? '0'));
    }

    function formatDiff(minutes: number): string
    {
        const hours = Math.floor(minutes / 60);
        const rest = minutes % 60;
        return rest ? `${hours}h ${rest}m` : `${hours}h`;
    }

    function updateClock() {
        const timeElement = document.getElementById('clock-time');
        const timeZoneElement = document.getElementById('clock-timezone-diff');

        if (!timeElement)
            return false;

        const now = new Date();
        timeElement.textContent = timeFormat.format(now);

        const timeZoneNameElement = document.getElementById('clock-timezone-name');
        const zoneName = nameFormat.formatToParts(now).find(part => part.type === 'timeZoneName')?.value;
        if (timeZoneNameElement && zoneName)
            timeZoneNameElement.textContent = zoneName;

        if (timeZoneElement)
        {
            const diff = -now.getTimezoneOffset() - myOffsetMinutes(now);
            const direction = diff > 0 ? 'behind you' : 'ahead of you';

            timeZoneElement.textContent = diff !== 0 ? `- ${formatDiff(Math.abs(diff))} ${direction}` : "";
        }

        return true;
    }

    function scheduleTick()
    {
        tickTimer = setTimeout(() =>
        {
            if (updateClock())
                scheduleTick();
            else
                tickTimer = null;
        }, 1000 - (Date.now() % 1000) + 10);
    }

    // ClientRouter only runs this script once
    document.addEventListener('astro:page-load', () =>
    {
        if (updateClock() && !tickTimer)
            scheduleTick();
    });

    document.addEventListener('astro:after-swap', updateClock);
    document.addEventListener('astro:before-swap', () =>
    {
        if (tickTimer)
            clearTimeout(tickTimer);
        tickTimer = null;
    });
</script>

<style>
    .clock-container {

        flex-direction: column;
        padding-left: 0.5em;
        padding-right: 0.5em;
    }
    
    .clock-display {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    
    .clock-time-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .clock-icon {
        width: 1.75rem;
        height: 1.75rem;
        flex-shrink: 0;
        filter: drop-shadow(0 0 10px rgba(0, 98, 189));
    }
    
    .clock-time {
        font-size: 1.125rem;
        font-weight: bold;
        font-family: var(--font-code);
        letter-spacing: 0.05em;
        text-shadow: 0 0 10px rgba(0, 98, 189);
    }
    
    .clock-timezone {
        font-size: 0.875rem;
        opacity: 0.7;
    }
    
    @media (min-width: theme('screens.md')) {
        .clock-icon {
            width: 2rem;
            height: 2rem;
        }
        
        .clock-time {
            font-size: 2rem;
        }
        
        .clock-timezone {
            font-size: 1rem;
        }
    }
</style>
